    "items": [
        {
            "id": "https://conv.pp.ua/konverter-video-v-mp3-2.html",
            "url": "https://conv.pp.ua/konverter-video-v-mp3-2.html",
            "title": "Конвертер Відео в MP3",
            "summary": "Надійне вилучення звуку з будь-яких форматів файлів прямо у вашому браузері. Підтримуються MP4, MKV, AVI, MOV, WebM тощо © 2026 conv.pp.ua. Безпечна локальна конвертація.",
            "content_html": "<p>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/ffmpeg/0.10.1/ffmpeg.min.js\" crossorigin=\"anonymous\"></script>\n</p>\n<header>\n<div class=\"logo-nav\"><a href=\"/\" class=\"logo\">conv.pp.ua</a> <a href=\"/\" class=\"back-link\">← На головну</a></div>\n<button id=\"themeToggle\" class=\"theme-toggle\">🌓 Тема</button></header><main>\n<div class=\"tool-header\">\n<h1>Конвертер Відео в MP3</h1>\n<p>Надійне вилучення звуку з будь-яких форматів файлів прямо у вашому браузері.</p>\n</div>\n<div class=\"dropzone-container\">\n<div class=\"settings-box\"><label for=\"quality\">Якість звуку (Бітрейт):</label><select id=\"quality\" class=\"quality-select\">\n<option value=\"128k\">128 kbps (Малий розмір)</option>\n<option selected=\"selected\" value=\"192k\">192 kbps (Стандарт)</option>\n<option value=\"320k\">320 kbps (Найвища якість)</option>\n</select></div>\n<div id=\"dropzone\" class=\"dropzone\">\n<div style=\"font-size: 3rem; margin-bottom: 1rem;\">🎬</div>\n<h3>Оберіть або перетягніть будь-яке відео</h3>\n<p>Підтримуються MP4, MKV, AVI, MOV, WebM тощо</p>\n<button class=\"btn-browse\" style=\"margin-top: 1rem;\">Вибрати файл</button> <input type=\"file\" id=\"fileInput\" class=\"file-input\"></div>\n<div id=\"processBox\" class=\"process-box\">\n<div class=\"file-info\"><span id=\"fileName\" class=\"word-break: break-all;\">video.mp4</span> <span id=\"fileSize\" style=\"color: var(--text-muted); font-size: 0.875rem;\">0 MB</span></div>\n<div class=\"progress-bar-container\">\n<div id=\"progressBar\" class=\"progress-bar\"></div>\n</div>\n<div style=\"display: flex; justify-content: space-between; align-items: center; min-height: 38px;\"><span id=\"statusText\" style=\"font-size: 0.875rem; color: var(--text-muted);\">Завантаження кодеків...</span> <a id=\"downloadBtn\" class=\"btn-download\"></a>Завантажити MP3</div>\n</div>\n</div>\n</main><footer>\n<p>© 2026 conv.pp.ua. Безпечна локальна конвертація.</p>\n</footer>\n<p>\n<script>\n        // Тема\n        const themeToggle = document.getElementById('themeToggle');\n        const savedTheme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');\n        document.documentElement.setAttribute('data-theme', savedTheme);\n        themeToggle.addEventListener('click', () => {\n            const currentObj = document.documentElement;\n            const nextTheme = currentObj.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';\n            currentObj.setAttribute('data-theme', nextTheme);\n            localStorage.setItem('theme', nextTheme);\n        });\n\n        // Інтерфейс\n        const dropzone = document.getElementById('dropzone');\n        const fileInput = document.getElementById('fileInput');\n        const processBox = document.getElementById('processBox');\n        const fileNameEl = document.getElementById('fileName');\n        const fileSizeEl = document.getElementById('fileSize');\n        const progressBar = document.getElementById('progressBar');\n        const statusText = document.getElementById('statusText');\n        const downloadBtn = document.getElementById('downloadBtn');\n        const qualitySelect = document.getElementById('quality');\n\n        let createdUrl = null;\n\n        // Ініціалізація FFmpeg з бібліотеки скрипта\n        const { createFFmpeg, fetchFile } = FFmpeg;\n        const ffmpeg = createFFmpeg({ log: false });\n\n        ['dragenter', 'dragover'].forEach(eName => {\n            dropzone.addEventListener(eName, (e) => { e.preventDefault(); dropzone.classList.add('dragover'); });\n        });\n        ['dragleave', 'drop'].forEach(eName => {\n            dropzone.addEventListener(eName, (e) => { e.preventDefault(); dropzone.classList.remove('dragover'); });\n        });\n\n        dropzone.addEventListener('drop', (e) => {\n            const files = e.dataTransfer.files;\n            if (files.length) handleConversion(files[0]);\n        });\n\n        fileInput.addEventListener('change', (e) => {\n            if (e.target.files.length) handleConversion(e.target.files[0]);\n        });\n\n        // ГОЛОВНИЙ НАДІЙНИЙ ПРОЦЕС КОНВЕРТАЦІЇ\n        async function handleConversion(file) {\n            if (createdUrl) URL.revokeObjectURL(createdUrl);\n\n            processBox.style.display = 'block';\n            fileNameEl.textContent = file.name;\n            fileSizeEl.textContent = (file.size / (1024 * 1024)).toFixed(2) + ' MB';\n            progressBar.style.width = '0%';\n            downloadBtn.style.display = 'none';\n\n            try {\n                // 1. Перевіряємо, чи завантажено ядро кодека в браузер\n                if (!ffmpeg.isLoaded()) {\n                    statusText.textContent = 'Завантаження локального ядра кодека...';\n                    await ffmpeg.load();\n                }\n\n                statusText.textContent = 'Підготовка файлу...';\n                const bitrate = qualitySelect.value;\n                const inputName = 'input_' + Date.now() + file.name.substring(file.name.lastIndexOf('.'));\n                const outputName = 'output_' + Date.now() + '.mp3';\n\n                // Передаємо файл у ізольовану пам'ять FFmpeg\n                ffmpeg.FS('writeFile', inputName, await fetchFile(file));\n\n                statusText.textContent = 'Конвертація аудіо (обробка у браузері)...';\n                progressBar.style.width = '40%';\n\n                // Відстежуємо прогрес через логи FFmpeg\n                ffmpeg.setProgress(({ ratio }) => {\n                    if(ratio >= 0 && ratio <= 1) {\n                        progressBar.style.width = Math.round(ratio * 100) + '%';\n                        statusText.textContent = `Обробка: ${Math.round(ratio * 100)}%`;\n                    }\n                });\n\n                // 2. Запуск повноцінного перекодування абсолютно будь-якого кодека в чистий MP3\n                await ffmpeg.run('-i', inputName, '-vn', '-acodec', 'libmp3lame', '-b:a', bitrate, outputName);\n\n                statusText.textContent = 'Збирання результату...';\n                progressBar.style.width = '90%';\n\n                // 3. Забираємо готовий чистий MP3-файл\n                const data = ffmpeg.FS('readFile', outputName);\n                const mp3Blob = new Blob([data.buffer], { type: 'audio/mp3' });\n                \n                createdUrl = URL.createObjectURL(mp3Blob);\n                downloadBtn.href = createdUrl;\n                \n                const rawName = file.name.substring(0, file.name.lastIndexOf('.')) || file.name;\n                downloadBtn.download = `${rawName}.mp3`;\n\n                // Очищаємо віртуальну пам'ять браузера, щоб не було перевантаження\n                ffmpeg.FS('unlink', inputName);\n                ffmpeg.FS('unlink', outputName);\n\n                progressBar.style.width = '100%';\n                statusText.textContent = 'Конвертацію успішно завершено!';\n                downloadBtn.style.display = 'inline-block';\n\n            } catch (err) {\n                console.error(err);\n                statusText.textContent = 'Помилка кодека. Спробуйте інший файл або перезапустіть сторінку.';\n                progressBar.style.width = '0%';\n            }\n        }\n    </script>\n</p>",
            "author": {
                "name": "Bodka"
            },
